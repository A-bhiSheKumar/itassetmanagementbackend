# Every variable here is validated by src/config/env.ts at boot.
# The process refuses to start if one is missing or malformed — better than
# discovering it at 3am on the first request that needs it.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# A replica set is REQUIRED: multi-document transactions (assign/return/transfer,
# import commit) do not work on a standalone mongod.
MONGO_URI=mongodb://localhost:27017/itam?replicaSet=rs0&directConnection=true

# --- Redis (queues, cache, rate limits) -------------------------------------
# Optional in development: without it, jobs run in-process with no durability
# and no retries, and the worker says so loudly on start. REQUIRED in
# production, where an unreachable Redis is a fatal boot error.
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-in-production-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-too-in-production-min-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Object storage (MinIO locally, S3/R2 in production) --------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=itam-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
