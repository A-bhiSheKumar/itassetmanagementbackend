# Every variable here is validated by src/config/env.ts at boot.
# The process refuses to start if one is missing or malformed — better than
# discovering it at 3am on the first request that needs it.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# A replica set is REQUIRED: multi-document transactions (assign/return/transfer,
# import commit) do not work on a standalone mongod.
MONGO_URI=mongodb://localhost:27017/itam?replicaSet=rs0&directConnection=true

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-in-production-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-too-in-production-min-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Object storage --------------------------------------------------------
# `local` writes under .storage/ (development and tests). `s3` is Amazon S3.
# Production refuses to start on `local`: Lambda's disk is read-only and wiped.
STORAGE_DRIVER=local
# For STORAGE_DRIVER=s3:
# S3_BUCKET=itam-files-dev
# S3_REGION=ap-south-1
# On AWS, leave the keys unset — Lambda's IAM role supplies credentials.
# Only set them (and S3_ENDPOINT + S3_FORCE_PATH_STYLE=true) for MinIO.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
